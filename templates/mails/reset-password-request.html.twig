{% extends 'mails/base.html.twig' %}

{% block title %}
    <h1>Récupération de votre mot de passe TasteHub</h1>
{% endblock %}

{% block content %}
    <p>
        Vous recevez ce mail car vous avez effectué une demande de réinitialisation de mot de passe sur l'application TasteHub pour le compte associé à l'adresse email : <strong>{{ resetPasswordRequest.user.email }}</strong>.
    </p>
    <p>
        Veuillez cliquer sur le lien ci-dessous pour définir un nouveau mot de passe.
    </p>

    <div class="link-container">
        <a href="{{ url('user_security_reset_password', {token: resetPasswordRequest.token}) }}" class="button">
            Réinitialiser mon mot de passe
        </a>
        <p class="small">Lien valable jusqu'au : {{ resetPasswordRequest.expireAt|date('d/m/Y H:i') }}</p>
    </div>
{% endblock %}
