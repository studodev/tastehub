{% extends 'pages/user/account/layout.html.twig' %}

{% block title %}
    Mes informations | {{ parent() }}
{% endblock %}

{% block content %}
    <h2>Mes informations</h2>

    {{ form_start(form) }}
    {{ form_row(form.username) }}
    {{ form_row(form.email) }}

    <div class="form-actions">
        <button class="button">
            Enregistrer
        </button>
    </div>
    {{ form_end(form) }}
{% endblock %}
