{% extends 'pages/user/account/layout.html.twig' %}

{% block title %}
    Mon mot de passe | {{ parent() }}
{% endblock %}

{% block content %}
    <h2>Mon mot de passe</h2>

    {{ form_start(form) }}
    {{ form_row(form.currentPassword) }}
    {{ form_row(form.plainPassword) }}

    <div class="form-actions">
        <button class="button">
            Enregistrer
        </button>
    </div>
    {{ form_end(form) }}
{% endblock %}
