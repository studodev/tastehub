{% extends 'base.html.twig' %}

{% block title %}
    Réinitialiser votre mot de passe | {{ parent() }}
{% endblock %}

{% block stylesheets %}
    {{ encore_entry_link_tags('user_security_common') }}
{% endblock %}

{% block javascripts %}
    {{ encore_entry_script_tags('user_security_common') }}
{% endblock %}

{% block mainClass %}small page-spacer{% endblock %}

{% block body %}
    <div class="content">
        <h1>Réinitialiser votre mot de passe</h1>
        {{ form_start(form) }}
        <p class="information"><span>Saisissez votre nouveau mot de passe.</span><br> Après l'envoi du formulaire, le nouveau mot de passe est immédiatement fonctionnel.</p>

        {{ form_row(form.plainPassword) }}
        <button class="button">Confirmer</button>
        {{ form_end(form) }}
    </div>
    <div class="decoration"></div>
{% endblock %}
