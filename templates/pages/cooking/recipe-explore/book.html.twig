{% extends 'base.html.twig' %}

{% set isSelfBook = app.user is same as user %}
{% set pageTitle = isSelfBook ? 'Mon livre de recette' : 'Livre de recette de ' ~ user.username %}

{% block title %}
    {{ pageTitle }} | {{ parent() }}
{% endblock %}

{% block stylesheets %}
    {{ encore_entry_link_tags('cooking_recipe_explore_book') }}
{% endblock %}

{% block javascripts %}
    {{ encore_entry_script_tags('cooking_recipe_explore_book') }}
{% endblock %}

{% block mainClass %}{% endblock %}

{% block body %}
    <section class="recipe-gallery"
         data-url="{{ url('cooking_recipe_explore_book', {slug: user.slug}) }}"
         data-offset="{{ pagination.offset }}"
         data-total="{{ pagination.total }}">
        <header class="title-container page-spacer">
            <h1>{{ pageTitle }}</h1>

            <div class="actions">
                <a href="{{ path('cooking_recipe_explore_index') }}" class="button outline small water">Explorer toutes les recettes</a>
                <a href="{{ path('cooking_recipe_form_new') }}" class="button small water">Créer une recette</a>
            </div>
        </header>

        {{ form_start(form) }}
        <div class="search-container page-spacer">
            {{ form_row(form.query) }}
            {{ form_row(form.sort) }}
        </div>

        <aside class="filter-container" data-expander>
            <div class="fake-label expander-trigger">Filtrer</div>

            {{ form_row(form.categories) }}
            {{ form_row(form.diets) }}
            {{ form_row(form.tags) }}
            {{ form_row(form.duration) }}
        </aside>

        <div class="recipe-holder-wrapper">
            <ul class="recipe-holder">
                {% include 'components/cooking/recipe-list.html.twig' with {
                    recipes: pagination.results,
                } only %}
            </ul>

            <button type="button" class="recipe-load-more button">Voir plus</button>

            <div class="recipe-holder-empty">
                <img src="{{ asset('build/images/illustrations/empty.svg') }}" alt="Une personne entourée d'ingrédients devant une assiette vide">
                <p>
                    {% if isSelfBook %}
                        <span>Oh non, nous n'avons rien trouvé pour vous régaler dans votre livre</span>
                        Mais ne partez pas le ventre vide !<br>
                        Vous pouvez modifier vos critères de recherche,
                        <a href="{{ path('cooking_recipe_form_new') }}">créer une recette</a>
                        ou <a href="{{ path('cooking_recipe_explore_index') }}">explorer toutes nos recettes</a>
                        pour trouver de quoi vous sustenter.
                    {% else %}
                        <span>Oh non, nous n'avons rien trouvé pour vous régaler dans ce livre</span>
                        Mais ne partez pas le ventre vide !<br>
                        Essayez de modifier vos critères de recherche
                        ou <a href="{{ path('cooking_recipe_explore_index') }}">explorez toutes nos recettes</a>
                        pour trouver de quoi vous sustenter.
                    {% endif %}
                </p>
            </div>
        </div>
        {{ form_end(form) }}

        <footer>
            {% include 'components/cooking/inspiration-banner.html.twig' with {
                bookMode: true,
            } only %}
        </footer>
    </section>
{% endblock %}
