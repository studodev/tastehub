{% extends 'base.html.twig' %}

{% block title %}
    {{ recipe.title }} | {{ parent() }}
{% endblock %}

{% block stylesheets %}
    {{ encore_entry_link_tags('cooking_recipe_view_single') }}
{% endblock %}

{% block javascripts %}
    {{ encore_entry_script_tags('cooking_recipe_view_single') }}
{% endblock %}

{% block body %}
    <header class="recipe-header content-frame">
        <img src="{{ recipe_image_url(recipe) }}" alt="{{ recipe.title }}" class="recipe-image">
        <div class="recipe-summary">
            <div class="header-aligned">
                <div class="recipe-title">
                    <span class="recipe-category">{{ recipe.category.label }}</span>
                    <h1>{{ recipe.title }}</h1>
                </div>

                {% if recipe.averageRating is not null %}
                    <div class="recipe-review">
                        {% for i in 1..5 %}
                            {% if i <= recipe.approximateRating %}
                                <i class="icon icon-star-filled"></i>
                            {% elseif i < recipe.approximateRating + 1 %}
                                <i class="icon icon-star-half"></i>
                            {% else %}
                                <i class="icon icon-star"></i>
                            {% endif %}
                        {% endfor %}
                        <span>{{ recipe.averageRating }}/5</span>
                        ({{ reviewPagination.total }} avis)
                    </div>
                {% endif %}
            </div>

            {% include 'components/cooking/recipe-timer.html.twig' with {
                recipe: recipe,
            } only %}

            <h2>Modes de cuisson</h2>
            <ul class="compact-list">
                {% for cookingMethod in recipe.cookingMethods %}
                    <li>
                        <i class="icon icon-{{ cookingMethod.icon }}"></i>
                        {{ cookingMethod.label }}
                    </li>
                {% endfor %}
            </ul>

            {% if recipe.diets|length > 0 %}
                <h2>Régimes</h2>
                <ul class="compact-list">
                    {% for diet in recipe.diets %}
                        <li>
                            <i class="icon icon-{{ diet.icon }}"></i>
                            {{ diet.label }}
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}

            <div class="header-aligned end">
                {% include 'components/social/profile-card.html.twig' with {
                    user: recipe.author,
                } only %}

                <ul class="recipe-tags">
                    {% for tag in recipe.tags %}
                        <li class="tag">
                            {{ tag.label }}
                        </li>
                    {% endfor %}
                </ul>
            </div>
        </div>
    </header>

    {% if recipe.description %}
        <p class="quote">
            {{ recipe.description }}
        </p>
    {% endif %}

    <div data-recipe-customizer="{{ url('cooking_recipe_view_customize', {slug: recipe.slug}) }}" class="recipe-content">
        {{ form(quantityForm) }}

        <div data-tab-navigation class="recipe-navigator">
            <nav class="tab-navigator">
                <ul>
                    <li>
                        <button data-tab-trigger="ingredients" class="active">
                            Ingrédients & ustensiles
                        </button>
                    </li>
                    <li>
                        <button data-tab-trigger="steps">
                            Étapes
                        </button>
                    </li>
                    <li>
                        <button data-tab-trigger="reviews">
                            Avis
                        </button>
                    </li>
                </ul>
            </nav>

            <section data-tab-content="ingredients" class="ingredient-utensil-container active">
                <div class="ingredient-list content-frame">
                    {% include 'components/cooking/ingredient-list.html.twig' with {
                        recipeIngredients: recipe.recipeIngredients,
                    } only %}
                </div>

                <div class="utensil-list content-frame">
                    {% include 'components/cooking/utensil-list.html.twig' with {
                        utensils: recipe.utensils,
                    } only %}
                </div>
            </section>

            <section data-tab-content="steps" class="step-container">
                {% include 'components/cooking/step-list.html.twig' with {
                    steps: recipe.steps,
                } only %}
            </section>

            <section data-tab-content="reviews" class="review-container">
                {% if is_granted('REVIEW_CREATE', recipe)%}
                    <div data-async-form="{{ url('cooking_recipe_view_reviewForm', {slug: recipe.slug}) }}"
                         class="review-form-wrapper content-frame">
                    </div>
                {% endif %}

                {% include 'components/cooking/review-holder.html.twig' with {
                    form: reviewFilterForm,
                    pagination: reviewPagination,
                    recipe: recipe,
                } only %}
            </section>
        </div>
    </div>
{% endblock %}
