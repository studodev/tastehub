{% extends 'base.html.twig' %}

{% block title %}
    {{ recipe.title }} | {{ parent() }}
{% endblock %}

{% block stylesheets %}
    {{ encore_entry_link_tags('cooking_recipe_view_single') }}
{% endblock %}

{% block javascripts %}
    {{ encore_entry_script_tags('cooking_recipe_view_single') }}
{% endblock %}

{% block body %}
    <header class="recipe-header content-frame">
        <img src="{{ recipe_image_url(recipe) }}" alt="{{ recipe.title }}" class="recipe-image">
        <div class="recipe-summary">
            <div class="header-aligned">
                <div class="recipe-title">
                    <span class="recipe-category">{{ recipe.category.label }}</span>
                    <h1>{{ recipe.title }}</h1>
                </div>
                <div class="recipe-review">

                </div>
            </div>

            {% include 'components/cooking/recipe-timer.html.twig' with {
                recipe: recipe,
            } only %}

            <h2>Modes de cuisson</h2>
            <ul class="compact-list">
                {% for cookingMethod in recipe.cookingMethods %}
                    <li>
                        <i class="icon icon-{{ cookingMethod.icon }}"></i>
                        {{ cookingMethod.label }}
                    </li>
                {% endfor %}
            </ul>

            {% if recipe.diets|length > 0 %}
                <h2>Régimes</h2>
                <ul class="compact-list">
                    {% for diet in recipe.diets %}
                        <li>
                            <i class="icon icon-{{ diet.icon }}"></i>
                            {{ diet.label }}
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}

            <div class="header-aligned end">
                {% include 'components/social/profile-card.html.twig' with {
                    user: recipe.author,
                } only %}

                <ul class="recipe-tags">
                    {% for tag in recipe.tags %}
                        <li class="tag">
                            {{ tag.label }}
                        </li>
                    {% endfor %}
                </ul>
            </div>
        </div>
    </header>

    {% if recipe.description %}
        <p class="quote">
            {{ recipe.description }}
        </p>
    {% endif %}

    <div data-tab-navigation class="recipe-content">
        {{ form(quantityForm) }}

        <nav class="tab-navigator">
            <ul>
                <li>
                    <button data-tab-trigger="ingredients" class="active">
                        Ingrédients & ustensiles
                    </button>
                </li>
                <li>
                    <button data-tab-trigger="steps">
                        Étapes
                    </button>
                </li>
                <li>
                    <button data-tab-trigger="reviews">
                        Avis
                    </button>
                </li>
            </ul>
        </nav>

        <section data-tab-content="ingredients" class="ingredient-utensil-container active">
            {% include 'components/cooking/ingredient-list.html.twig' with {
                recipeIngredients: recipe.recipeIngredients,
            } only %}

            {% include 'components/cooking/utensil-list.html.twig' with {
                utensils: recipe.utensils,
            } only %}
        </section>

        <section data-tab-content="steps" class="step-container">
            Étapes
        </section>

        <section data-tab-content="reviews" class="review-container">
            Avis
        </section>
    </div>
{% endblock %}
