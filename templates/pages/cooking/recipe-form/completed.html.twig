{% extends 'base.html.twig' %}

{% block title %}
    Création d'une recette | {{ parent() }}
{% endblock %}

{% block stylesheets %}
    {{ encore_entry_link_tags('cooking_recipe_form_completed') }}
{% endblock %}

{% block javascripts %}
    {{ encore_entry_script_tags('cooking_recipe_form_completed') }}
{% endblock %}

{% block body %}
    <h1>Création d'une recette</h1>

    <section>
        <h2>Bravo</h2>
        <p>
            Votre recette <strong>{{ recipe.title }}</strong> a bien été msie ligne !
        </p>

        {% if recipe.category.slug starts with 'entree' %}
            {% set categoryIllustration = 'starter' %}
            {% set categoryIllustrationAlt = 'Chef mélengeant le contenu d\'un saladier' %}
        {% elseif recipe.category.slug starts with 'dessert' %}
            {% set categoryIllustration = 'dessert' %}
            {% set categoryIllustrationAlt = 'Chef préparant le glaçage d\'un gâteau' %}
        {% elseif recipe.category.slug starts with 'boisson' %}
            {% set categoryIllustration = 'drink' %}
            {% set categoryIllustrationAlt = 'Barmaid préparant un cocktail' %}
        {% elseif recipe.category.slug starts with 'sauce' %}
            {% set categoryIllustration = 'sauce' %}
            {% set categoryIllustrationAlt = 'Chef goutant une sauce dans une marmite' %}
        {% else %}
            {% set categoryIllustration = 'main' %}
            {% set categoryIllustrationAlt = 'Illustration d\'un maître sushi tenant un plateau de sushis' %}
        {% endif %}

        <img src="{{ asset('build/images/illustrations/recipe-category/' ~ categoryIllustration ~ '.svg') }}" alt="{{ categoryIllustrationAlt }}">

        <a href="{{ path('cooking_recipe_form_new') }}" class="button water small">
            Créer une autre recette
        </a>
        <a href="{{ path('cooking_recipe_view_single', {slug: recipe.slug}) }}" class="button water outline small">
            Voir la recette
        </a>
    </section>
{% endblock %}
