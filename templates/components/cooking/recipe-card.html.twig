<article class="recipe-card">
    {% set recipeBucket = enum('App\\Enum\\Common\\FileManagerBucketEnum').Recipe %}
    <img src="{{ file_url(recipe.picture, recipeBucket) }}" alt="{{ recipe.title }}">

    <div class="recipe-rate">
        <i class="icon icon-star"></i>
        4.3
    </div>
    <div class="recipe-time">
        <i class="icon icon-clock"></i>
        {{ recipe.timer.totalTime|format_duration }}
    </div>
    <div class="recipe-category">{{ recipe.category.label }}</div>
    <h2>{{ recipe.title }}</h2>
</article>
