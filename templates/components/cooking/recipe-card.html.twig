<a href="{{ path('cooking_recipe_view_single', {slug: recipe.slug}) }}">
    <article class="recipe-card">
        <img src="{{ recipe_image_url(recipe) }}" alt="{{ recipe.title }}">

        {% if recipe.averageRating is not null %}
            <div class="recipe-rate">
                <i class="icon icon-star"></i>
                {{ recipe.averageRating|number_format(1, '.') }}
            </div>
        {% endif %}
        <div class="recipe-time">
            <i class="icon icon-clock"></i>
            {{ recipe.timer.totalTime|format_duration }}
        </div>
        <div class="recipe-category">{{ recipe.category.label }}</div>
        <h2>{{ recipe.title }}</h2>
    </article>
</a>
