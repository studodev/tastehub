{% for review in reviews %}
    <article class="review content-frame">
        <header class="review-header">
            <span class="review-user">
                {{ review.user.username }}
            </span>
            <span class="review-date">
                {{ review.createdAt|date('F Y') }}
            </span>
        </header>

        <div class="review-rating">
            {% for i in 1..5 %}
                {% if i <= review.rating %}
                    <i class="icon icon-star-filled"></i>
                {% else %}
                    <i class="icon icon-star"></i>
                {% endif %}
            {% endfor %}
            {{ review.rating }}/5
        </div>

        {% if review.comment %}
            <p class="review-content">{{ review.comment|nl2br }}</p>
        {% endif %}
    </article>
{% endfor %}
