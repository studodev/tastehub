<ol class="step-list">
    {% for step in steps %}
        <li class="step content-frame">
            <p class="step-description">
                {{ step.description|nl2br }}
            </p>
            <div class="step-ingredients" data-expander>
                <button class="step-ingredients-title expander-trigger">
                    Ingrédients
                    <i class="icon icon-chevron-down"></i>
                </button>

                {% if step.recipeIngredients|length > 0 %}
                    <ul>
                        {% for recipeIngredient in step.recipeIngredients %}
                            <li>
                                <span>{{ recipeIngredient.ingredient.label }}</span>
                                {{ recipeIngredient.measure }}
                            </li>
                        {% endfor %}
                    </ul>
                {% else %}
                    <span class="step-empty-list">
                        Aucun ingrédient renseigné
                    </span>
                {% endif %}
            </div>
        </li>
    {% endfor %}
</ol>
