{% block _recipe_utensils_entry_widget %}
    <div class="item">
        <div class="item-content">
            {% set pictogram = data is not empty ? pictogram_url(enum(enum.pictogramType).Utensil, data.pictogram) %}
            <img src="{{ pictogram }}" alt="{{ data is not empty ? 'Pictogramme ' ~ data.label }}" class="item-data-utensil-pictogram">

            <div class="item-form hidden">
                {{ form_widget(form) }}
            </div>

            {% if data is not empty %}
                <span class="item-data-utensil-label">{{ data.label }}</span>
            {% else %}
                <span class="item-data-utensil-label"></span>
            {% endif %}
        </div>

        <button type="button" class="item-remove-trigger" aria-label="Supprimer l'ustensile">
            <i class="icon icon-trash"></i>
        </button>
    </div>
{% endblock %}
