{% block _recipe_steps_entry_stepRecipeIngredients_entry_widget %}
    <div class="item item-step-ingredient">
        <div class="item-content">
            {% set pictogram = value is not null ? pictogram_url(enum(enum.common.pictogramType).Ingredient, value.recipeIngredient.ingredient.type.pictogram) %}
            <img src="{{ pictogram }}" alt="{{ value is not null ? 'Pictogramme ' ~ value.recipeIngredient.ingredient.type.label }}" class="item-data-ingredient-pictogram">

            <div>
                <span class="item-data-ingredient-label">
                    {{ value is null ?: value.recipeIngredient.ingredient.label }}
                </span>

                <div class="item-form">
                    {{ form_row(form.recipeIngredient) }}
                    {{ form_label(form.quantity) }}
                    {{ form_widget(form.quantity) }}
                    <span class="item-data-quantity-unit">
                        {{ value is null ?: value.recipeIngredient.unit.symbol }}
                    </span>
                </div>
            </div>
        </div>

        <button type="button" class="item-remove-trigger" aria-label="Supprimer l'ingrédient">
            <i class="icon icon-trash"></i>
        </button>
    </div>
{% endblock %}
